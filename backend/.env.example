NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
# Blank uses an embedded MongoDB in development. Production requires Atlas or MongoDB.
DATABASE_URL=
DATABASE_NAME=quizora
COOKIE_SAME_SITE=lax
PUBLIC_REGISTRATION_ENABLED=true
ORGANIZER_REGISTRATION_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SUPPORT_EMAIL=
BILLING_ENABLED=false
# Virtual access coins. BILLING_ENABLED above controls future recurring subscriptions only.
COIN_SYSTEM_ENABLED=true
PAID_QUIZZES_ENABLED=true
PAYMENTS_ENABLED=false
API_PUBLIC_URL=http://localhost:4000
# Persistent local development replica port; production uses DATABASE_URL (Atlas/replica set).
DEV_MONGO_PORT=57017
# TransactWorld Standard Checkout + authenticated Inquiry. Never put these in frontend env.
TW_ENVIRONMENT=sandbox
MEMBER_ID=
WORKING_KEY=
# Comma-separated currencies explicitly approved for this merchant. No assumed default.
TW_SUPPORTED_CURRENCIES=
# Optional manually supplied merchant API token; blank enables the authToken exchange.
TW_AUTH_TOKEN=
TW_MERCHANT_USERNAME=
TW_PARTNER_ID=
TO_TYPE=Transactworld
LANGUAGE=ENG
PAYMENT_MODE=CC
PAYMENT_BRAND=VISA
# Explicit loopback HTTP/HTTPS development override. Production always requires HTTPS.
# Server notifications cannot reach localhost; merchant-reference Inquiry recovers missing callbacks.
TW_ALLOW_LOCAL_CHECKOUT=false
# Both must be true to permit coin-entry live events. Enable only after merchant approval.
PAID_COMPETITIONS_ENABLED=false
PAID_EVENTS_MERCHANT_APPROVED=false
